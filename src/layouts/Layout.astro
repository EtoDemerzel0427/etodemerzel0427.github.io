---
import { ClientRouter } from 'astro:transitions';
import BackgroundManager from '../components/BackgroundManager';
import GlobalUI from '../components/GlobalUI';
import ThemeSync from '../components/ThemeSync';
import Header from '../components/Header';
import Footer from '../components/Footer';
import MusicPlayer from '../components/MusicPlayer'; // We will create this wrapper next
import { USER_CONTENT } from '../config';
import { getContainerClassMap } from '../utils/theme';
import { UNIVERSE_IDS, DEFAULT_UNIVERSE } from '../stores/universeStore';
import '../index.css';

const { 
    title = "Weiran's Universe", 
    showHeader = true,
    description = "From low-latency C++ to high-volatility markets. Exploring the intersection of Tech, Trading, Digital Art, and Music.",
    image,
    articleDate,
    canonicalURL 
} = Astro.props;

// Resolution logic for robust image URL handling
const resolvedImage = image ? new URL(image, Astro.site).toString() : new URL(USER_CONTENT.social.defaultImage, Astro.site).toString();
const resolvedCanonical = canonicalURL ? new URL(canonicalURL, Astro.site).toString() : new URL(Astro.url.pathname, Astro.site).toString();

// Painted before hydration by the boot script below.
const universeClasses = getContainerClassMap(UNIVERSE_IDS);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-geometric-32.png" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-geometric-dark-32.png" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-geometric-16.png" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-geometric-dark-16.png" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v3.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

        <!--
            Universe boot: the pages are pre-rendered in DEFAULT_UNIVERSE, so without
            this the first painted frame is always the default theme. Running before
            the body exists puts the visitor's universe on <html> in time for the very
            first paint, and re-running it on astro:after-swap survives ClientRouter
            navigations (Astro replaces the root element's attributes on swap).
        -->
        <script is:inline define:vars={{ universeClasses, defaultUniverse: DEFAULT_UNIVERSE }}>
            (function () {
                var root = document.documentElement;

                function applyUniverse() {
                    var stored;
                    try { stored = localStorage.getItem('universe'); } catch (error) { /* private mode */ }

                    var next = stored && universeClasses[stored] ? stored : defaultUniverse;

                    root.dataset.universe = next;
                    root.className = universeClasses[next] || '';

                    // Only gate the markup when the pre-rendered theme is the wrong one;
                    // first-time visitors get the static HTML with no delay at all.
                    if (next === defaultUniverse) delete root.dataset.themePending;
                    else root.dataset.themePending = '';
                }

                // Astro drops the `ssr` attribute from an island once it has hydrated, so
                // the markup is safe to show one frame after the last island loses it —
                // revealing any earlier shows islands still rendering the default theme.
                function revealWhenHydrated() {
                    var settledFrames = 0;

                    (function check() {
                        if (!('themePending' in root.dataset)) return;

                        if (document.querySelector('astro-island[ssr]')) settledFrames = 0;
                        else settledFrames += 1;

                        if (settledFrames > 1) delete root.dataset.themePending;
                        else requestAnimationFrame(check);
                    })();
                }

                applyUniverse();

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', revealWhenHydrated);
                } else {
                    revealWhenHydrated();
                }

                if (!window.__universeBoot) {
                    window.__universeBoot = true;
                    document.addEventListener('astro:after-swap', function () {
                        applyUniverse();
                        revealWhenHydrated();
                    });
                }
            })();
        </script>

        <!-- SEO Metadata -->
        <meta name="description" content={description} />
        <link rel="canonical" href={resolvedCanonical} />

        <!-- OpenGraph Tags -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={resolvedCanonical} />
        <meta property="og:image" content={resolvedImage} />
        <meta property="og:type" content={articleDate ? "article" : "website"} />
        {articleDate && <meta property="article:published_time" content={articleDate} />}

        <!-- Twitter Card Tags -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={resolvedImage} />

        <!-- Google Analytics (Partytown) -->
        {import.meta.env.PROD && USER_CONTENT.googleAnalytics?.id && (
            <>
                <script is:inline type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=${USER_CONTENT.googleAnalytics.id}`}></script>
                <script is:inline type="text/partytown" define:vars={{ gaId: USER_CONTENT.googleAnalytics.id }}>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', gaId);
                </script>
            </>
        )}

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bangers&family=DM+Sans:ital,wght@0,400;0,700;1,400&family=Inter:wght@200;300;400;600&family=JetBrains+Mono:wght@400;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Orbitron:wght@400;700;900&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Press+Start+2P&display=swap" rel="stylesheet">

        <!-- Custom Fonts Injection -->
        <style is:global>
            @font-face {
              font-family: 'Cubic';
              src: url('/fonts/Cubic_11.woff2') format('woff2');
              font-weight: normal;
              font-style: normal;
              font-display: swap;
            }

            /* Your custom fonts from RootLayout */
            .font-academic { font-family: 'Playfair Display', serif; }
            .font-code { font-family: 'JetBrains Mono', monospace; }
            .font-pixel { font-family: 'Press Start 2P', 'Cubic', cursive; }
            .font-serif { font-family: 'Lora', serif; }
            .font-comic { font-family: 'Bangers', cursive; letter-spacing: 0.05em; }
            .font-hand { font-family: 'Patrick Hand', cursive; }
            .font-cyber { font-family: 'Orbitron', sans-serif; }
            .font-geo { font-family: 'DM Sans', sans-serif; }
            
            .no-scrollbar::-webkit-scrollbar { display: none; }
            .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

            .text-shadow-glow { text-shadow: 0 0 5px rgba(0, 255, 65, 0.5); }
            
            @keyframes blob {
                0% { transform: translate(0px, 0px) scale(1); }
                33% { transform: translate(50px, -80px) scale(1.2); }
                66% { transform: translate(-40px, 40px) scale(0.8); }
                100% { transform: translate(0px, 0px) scale(1); }
            }
            .animate-blob { animation: blob 5s infinite ease-in-out alternate; }
            .animation-delay-2000 { animation-delay: 2s; }
            .animation-delay-4000 { animation-delay: 4s; }
            .animation-delay-6000 { animation-delay: 6s; }

            /* Universe-specific CSS patterns (Scanlines, Halftone, etc) */
            .scanlines {
                background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2));
                background-size: 100% 4px;
            }
            .halftone {
                background-image: radial-gradient(circle, #000 1px, transparent 1px);
                background-size: 8px 8px;
            }
            .manga-speedlines {
                background: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(0,0,0,0.05) 10px, rgba(0,0,0,0.05) 20px);
            }
            .cyber-clip {
                clip-path: polygon(0 0, 100% 0, 100% 90%, 95% 100%, 0 100%);
            }
            .cyber-glitch {
                background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255, 255, 0, 0.05) 3px);
            }
            .caution-tape {
                background: repeating-linear-gradient(45deg, #fcee0a, #fcee0a 10px, #000 10px, #000 20px);
            }
            .comic-halftone {
                position: relative;
                z-index: 1;
            }
            .comic-halftone::before {
                content: "";
                position: absolute;
                top: 0; left: 0; width: 100%; height: 100%;
                background-image: radial-gradient(#000 1px, transparent 1px);
                background-size: 6px 6px;
                opacity: 0.02;
                pointer-events: none;
                z-index: -1;
            }
            .film-grain {
                background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.15'/%3E%3C/svg%3E");
            }
            .terminal-scanlines {
                background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
                background-size: 100% 2px, 3px 100%;
            }
            .neon-glow-card {
                box-shadow: 0 10px 40px -10px rgba(0,0,0,0.1), inset 0 2px 0 rgba(255,255,255,0.5), inset 0 -2px 0 rgba(0,0,0,0.05);
            }
            .neon-glow-card::before {
                content: "";
                position: absolute;
                top: 0; left: 0; right: 0; height: 100%;
                background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 60%);
                pointer-events: none;
            }
            /* --- Universe boot (see the inline script in <head>) --- */
            /* Hide the markup only while the pre-rendered theme is the wrong one, so
               the visitor never sees the default universe morph into theirs. The page
               background is on <html> and stays visible throughout. */
            html[data-theme-pending] body {
                visibility: hidden;
                /* Safety net: reveal anyway if hydration is slow or never happens. */
                animation: universe-reveal 0s 600ms forwards;
            }
            @keyframes universe-reveal {
                to { visibility: visible; }
            }

            /* Background overlays carry no universe in their markup, so the right one
               is painted with the first frame instead of after hydration. */
            .u-overlay { display: none; }
            html[data-universe="retro"] .u-overlay--retro,
            html[data-universe="terminal"] .u-overlay--terminal,
            html[data-universe="newspaper"] .u-overlay--newspaper,
            html[data-universe="comic"] .u-overlay--comic,
            html[data-universe="lofi"] .u-overlay--lofi,
            html[data-universe="cyberpunk"] .u-overlay--cyberpunk {
                display: block;
            }

            @keyframes music-bar {
                0%, 100% { height: 40%; }
                50% { height: 100%; }
            }


        </style>
		<ClientRouter />
	</head>
	<body class="min-h-screen relative z-0">
        <!-- WeChat Sharing Optimization (Hidden Image Hack) -->
        <div style="display:none; visibility:hidden; width:0; height:0;">
            <img src={resolvedImage} alt="wechat-thumb" width="300" height="300" loading="lazy" decoding="async" />
        </div>

        <!-- Persistent Global UI (Backgrounds, Modals, Music) -->
        <!-- client:only="react" ensures they run on client side from the start -->
        <!-- Music Player: We need to implement it to verify "music continues playing" -->
        <!-- <MusicPlayer client:only="react" transition:persist="music" /> -->
        
	        <div class="relative z-10 flex min-h-screen flex-col overflow-x-clip p-4 md:p-8">
            <ThemeSync client:load />
            <BackgroundManager client:load />
            <GlobalUI client:load />
            <MusicPlayer client:load transition:persist="music" />

            {/* HEADER - Wrapped for alignment */}
            {showHeader && (
                <div class="w-full max-w-7xl mx-auto pt-12">
                    <Header client:load>
                        <div slot="fallback" class="h-20 w-full animate-pulse bg-white/5 rounded-xl mb-12"></div>
                    </Header>
                </div>
            )}

            <!-- Main Content Slot -->
            <main class="flex-1 w-full max-w-7xl mx-auto flex flex-col">
    		    <slot />
                <Footer client:load>
                    <div slot="fallback" class="h-16 w-full animate-pulse bg-white/5 rounded-xl mt-8"></div>
                </Footer>
            </main>
        </div>
	</body>
</html>
