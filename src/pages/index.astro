---
import Layout from '../layouts/Layout.astro';
import BentoGrid from '../components/BentoGrid';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { libraryData } from '../data/library';
import currentLibrary from '../data/current-library.json';
import { USER_CONTENT, LAYOUT_CONFIG } from '../config';
import { findLibraryItemById } from '../utils/library';
import { sortPostsByDate, toPostSummary } from '../utils/posts';
import type { PostSummary } from '../utils/posts';

const allPosts = await getCollection('posts');
const posts: PostSummary[] = sortPostsByDate(allPosts.map(
    (post: CollectionEntry<'posts'>) => toPostSummary(post)
));

const latestPost = posts.length > 0 ? posts[0] : null;
const postCount = posts.length;

const latestGame = findLibraryItemById(libraryData, currentLibrary.gameId, USER_CONTENT.game);
const latestBook = findLibraryItemById(libraryData, currentLibrary.readingId, USER_CONTENT.reading);

---

<Layout title="Weiran's Universe">
    <BentoGrid 
        client:load
        latestPost={latestPost} 
        postCount={postCount}
        latestGameData={latestGame}
        latestBookData={latestBook}
    >
        <div slot="fallback" class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 auto-rows-[200px] md:auto-rows-[240px]">
            {LAYOUT_CONFIG.map(card => (
                 <div
                    class={`bg-gray-200/5 rounded-3xl animate-pulse col-span-${card.colSpan || 1} row-span-${card.rowSpan || 1} ${card.className || ''}`}
                 ></div>
            ))}
        </div>
    </BentoGrid>
</Layout>
