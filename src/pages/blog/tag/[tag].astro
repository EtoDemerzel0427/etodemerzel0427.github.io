
---
import Layout from '../../../layouts/Layout.astro';
import BlogList from '../../../components/react-pages/BlogList';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { sortPostsByDate, toPostSummary } from '../../../utils/posts';
import type { PostSummary } from '../../../utils/posts';

export async function getStaticPaths() {
    const allPosts = await getCollection('posts');
    const posts: PostSummary[] = sortPostsByDate(allPosts.map(
        (post: CollectionEntry<'posts'>) => toPostSummary(post)
    ));
    
    const uniqueTags = [...new Set(posts.flatMap(post => post.tags || []))];

    return uniqueTags.map(tag => {
        const filteredPosts = posts.filter(post => post.tags && post.tags.includes(tag));
        return {
            params: { tag },
            props: { posts: filteredPosts, tag },
        };
    });
}

const { posts, tag } = Astro.props;
---

<Layout title={`Tag: ${tag} | Weiran's Universe`}>
    <BlogList client:load posts={posts} activeTag={tag} />
</Layout>
